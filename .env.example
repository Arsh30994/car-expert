# Copy this file to .env for local development. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-local-secret
AIMLAPI_API_KEY=replace-with-your-aimlapi-api-key
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_MODEL=alibaba/qwen3.7-max
# AIMLAPI_VISION_MODEL=configure-a-model-confirmed-to-support-images

# Leave DATABASE_URL unset to use the local SQLite database. Production requires PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/car_expert
